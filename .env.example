# Entorno: development | production | test
NODE_ENV=development

# Puerto del servidor Express
PORT=3000

# Cadena de conexión a MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/habitmaster

# Secreto para firmar los JWT (usa un valor largo y aleatorio)
# Genera uno con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=cambia_este_secreto_por_uno_largo_y_aleatorio

# Tiempo de expiración del JWT (formato vercel/ms: 15m, 1h, 7d...)
JWT_EXPIRES_IN=7d

# Rondas de sal para bcrypt
BCRYPT_SALT_ROUNDS=12

# Orígenes permitidos para CORS (separados por coma). Vacío = mismo origen
CORS_ORIGIN=
